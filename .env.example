# SeekRelay configuration. Copy to .env and fill in what you have.
# Providers without credentials are skipped automatically.

# Priority order (first that succeeds wins). Cheapest first is a good default for
# scheduled jobs: searxng,brave,tavily
SEEKRELAY_PROVIDERS=tavily,brave,searxng

# Tavily - https://app.tavily.com (1,000 free credits/month)
TAVILY_API_KEY=
# true = ask Tavily for a short generated answer
TAVILY_INCLUDE_ANSWER=false

# Brave Search API - https://api-dashboard.search.brave.com
BRAVE_API_KEY=

# Self-hosted SearXNG (see deploy/searxng). Keep it on localhost or behind auth.
SEARXNG_BASE_URL=
# Optional: pin web-search engines, e.g. brave,bing,duckduckgo,yahoo
# (see docs/DEPLOY_SEARXNG.md, availability depends on the server's IP address)
SEARXNG_ENGINES=
# Optional: full Authorization header value if SearXNG sits behind a reverse proxy
SEARXNG_AUTH_HEADER=

# Behaviour
SEEKRELAY_TIMEOUT=20
SEEKRELAY_MAX_ATTEMPTS=2
SEEKRELAY_CACHE_TTL=600
SEEKRELAY_COOLDOWN=300
# Max seconds for one search/extract across all providers and retries (empty = no limit)
SEEKRELAY_TIME_BUDGET=
SEEKRELAY_PII_GUARD=true
